# Copy to .env (gitignored) and adjust for your host.
# Defaults match docker-compose.yml — change a port or DB name here to
# avoid colliding with another local service or another worktree's stack.

MONGO_DB=mora_knode_work
MONGO_PORT=27017
BACKEND_PORT=5163
FRONTEND_PORT=8081
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222

# Baked into the frontend bundle at build time (Flutter web's
# String.fromEnvironment is compile-time). If you serve the UI under a
# different host, change this and rebuild the frontend image.
MORA_KNODE_API=http://localhost:5163
